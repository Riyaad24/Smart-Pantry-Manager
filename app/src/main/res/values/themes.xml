<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_indigo_variant</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/text_medium_contrast</item>
        <item name="colorOnSecondary">@color/bg_deep_slate</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_deep_slate</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background and Surface -->
        <item name="android:windowBackground">@color/bg_deep_slate</item>
        <item name="colorSurface">@color/surface_soft_charcoal</item>
        <item name="colorOnSurface">@color/text_high_contrast</item>
        <item name="colorSurfaceVariant">@color/surface_soft_charcoal</item>
        <item name="colorOnSurfaceVariant">@color/text_medium_contrast</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/AppHeadlineLarge</item>
        <item name="textAppearanceTitleMedium">@style/AppTitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/AppBodyLarge</item>

        <!-- Components styling -->
        <item name="materialCardViewStyle">@style/AppCardStyle</item>
        <item name="textInputStyle">@style/AppTextInputStyle</item>
        <item name="bottomNavigationStyle">@style/AppBottomNavStyle</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />

    <!-- Typography Styles -->
    <style name="AppHeadlineLarge">
        <item name="android:textColor">@color/text_high_contrast</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppTitleMedium">
        <item name="android:textColor">@color/text_high_contrast</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppBodyLarge">
        <item name="android:textColor">@color/text_medium_contrast</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Component Styles -->
    <style name="AppCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_soft_charcoal</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/accent_indigo</item>
        <item name="strokeWidth">0.5dp</item>
    </style>

    <style name="AppTextInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_indigo</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_medium_contrast</item>
        <item name="android:textColorHint">@color/text_low_contrast</item>
    </style>

    <style name="AppBottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface_soft_charcoal</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemRippleColor">@color/accent_indigo</item>
    </style>
</resources>