<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="10dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/stroke_subtle">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/surface_soft_charcoal">

        <!-- Visual Thumbnail representation area box container -->
        <TextView
            android:id="@+id/lblRecipeFoodBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="🍽️"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@color/accent_indigo_dim"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtRecipeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textAppearance="@style/AppTitleMedium"
            android:textColor="@color/text_high_contrast"
            tools:text="Scrambled Eggs with Toast"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/lblRecipeFoodBadge"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- High density match state indicator completeness badge row layout -->
        <TextView
            android:id="@+id/txtRecipeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@color/success_green_bg"
            android:textColor="@color/success_green"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            tools:text="100% Match • Ready to cook"
            app:layout_constraintTop_toBottomOf="@id/txtRecipeName"
            app:layout_constraintStart_toStartOf="@id/txtRecipeName" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>