<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_slate">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_deep_slate"
        app:elevation="0dp">

        <!-- Background-less structural app bar area spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@color/bg_deep_slate" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="90dp">

            <!-- Premium Visual Header Block Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kitchen Profile"
                android:textAppearance="@style/AppHeadlineLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Customize your preference criteria and threshold alerts"
                android:textAppearance="@style/AppBodySmall"
                android:textColor="@color/text_medium_contrast" />

            <!-- SUBSECTION HEADER: ALERTS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="NOTIFICATION NOTICES"
                android:textAppearance="@style/AppTitleSmall" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@color/surface_soft_charcoal">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchExpiryAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expiry Alerts"
                        android:textAppearance="@style/AppTitleMedium"
                        app:thumbTint="@color/accent_indigo"
                        app:trackTint="@color/text_low_contrast" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Get notified before ingredients reach maturity limits"
                        android:textAppearance="@style/AppBodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SUBSECTION HEADER: MEASUREMENTS -->
            <TextView
                android:id="@+id/txtUnitsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="MEASUREMENT STANDARDS"
                android:textAppearance="@style/AppTitleSmall" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_subtle">

                <RadioGroup
                    android:id="@+id/radioUnits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@color/surface_soft_charcoal">

                    <RadioButton
                        android:id="@+id/radioMetric"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="Metric System (kg, ml, g)"
                        android:buttonTint="@color/accent_indigo"
                        android:textColor="@color/text_high_contrast"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_subtle"
                        android:layout_marginHorizontal="12dp" />

                    <RadioButton
                        android:id="@+id/radioImperial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp"
                        android:text="Imperial System (lb, oz, pcs)"
                        android:buttonTint="@color/accent_indigo"
                        android:textColor="@color/text_high_contrast"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="14sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        style="@style/AppBottomNavStyle" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>