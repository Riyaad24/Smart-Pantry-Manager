<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep_slate">

    <!-- MAIN SCROLL CONTAINER FOR THE PREMIUM CONSUMER OVERVIEW DASHBOARD -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/containerDashboardHub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp">

            <!-- Personalized Greeting Area -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good evening, Riyaad 👋"
                android:textAppearance="@style/AppHeadlineLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Let's make something delicious."
                android:textAppearance="@style/AppBodyLarge"
                android:textColor="@color/text_medium_contrast" />

            <!-- What's in Your Pantry Health Overview Card View Block -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_subtle">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:background="@color/surface_soft_charcoal">

                    <TextView
                        android:id="@+id/lblPantryIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="🍳"
                        android:textSize="24sp"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/lblPantryCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="What's in your pantry?"
                        android:textAppearance="@style/AppTitleMedium"
                        app:layout_constraintTop_toTopOf="@id/lblPantryIcon"
                        app:layout_constraintStart_toEndOf="@id/lblPantryIcon"
                        app:layout_constraintEnd_toStartOf="@id/btnViewInventoryList"/>

                    <TextView
                        android:id="@+id/lblIngredientsCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Calculating parameters..."
                        android:textAppearance="@style/AppBodySmall"
                        android:textColor="@color/text_medium_contrast"
                        app:layout_constraintTop_toBottomOf="@id/lblPantryCardTitle"
                        app:layout_constraintStart_toStartOf="@id/lblPantryCardTitle"
                        app:layout_constraintEnd_toStartOf="@id/btnViewInventoryList"/>

                    <TextView
                        android:id="@+id/btnViewInventoryList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View →"
                        android:textColor="@color/accent_indigo"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:background="?attr/selectableItemBackground"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: EXPIRING SOON -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="EXPIRING SOON"
                android:textAppearance="@style/AppTitleSmall" />

            <!-- Horizontal Carousel Preview Scroller -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Mock Premium Food Pill 1: Milk -->
                    <LinearLayout
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/surface_soft_charcoal"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:text="🥛"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:background="@color/accent_indigo_dim"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Milk"
                            android:textAppearance="@style/AppTitleMedium"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 days left"
                            android:textSize="12sp"
                            android:textColor="@color/error_red"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <!-- Mock Premium Food Pill 2: Tomatoes -->
                    <LinearLayout
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/surface_soft_charcoal"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:text="🍅"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:background="@color/warning_amber_bg"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Tomatoes"
                            android:textAppearance="@style/AppTitleMedium"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 days left"
                            android:textSize="12sp"
                            android:textColor="@color/warning_amber"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- SECTION: FEATURED RECOMMENDATION HERO VIEW BLOCK (Powered by TheMealDB API) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="WHAT'S FOR YOU TODAY?"
                android:textAppearance="@style/AppTitleSmall" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/surface_soft_charcoal">

                    <!-- LIVE HIGH IMPACT FOOD IMAGE CONTAINER FROM API -->
                    <ImageView
                        android:id="@+id/imgFeaturedMeal"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="@color/accent_indigo_dim"
                        android:contentDescription="Featured Meal Preview" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/lblFeaturedTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Retrieving curated selections..."
                            android:textAppearance="@style/AppHeadlineMedium" />

                        <TextView
                            android:id="@+id/lblFeaturedSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fetching parameters from TheMealDB API"
                            android:textAppearance="@style/AppBodySmall" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="View recipe  →"
                            android:textColor="@color/accent_indigo"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: QUICK IDEAS FILTERS CATEGORY CHIPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="QUICK IDEAS"
                android:textAppearance="@style/AppTitleSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍳 Breakfast"
                    android:background="@color/accent_indigo_dim"
                    android:textColor="@color/accent_indigo"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥗 Lunch"
                    android:background="@color/surface_soft_charcoal"
                    android:textColor="@color/text_medium_contrast"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍝 Dinner"
                    android:background="@color/surface_soft_charcoal"
                    android:textColor="@color/text_medium_contrast"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- COMPLETE DEDICATED FULL INVENTORY MANIFEST LIST (INITIALLY HIDDEN VIEW STATE) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerInventoryList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblListHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:text="CURRENT INVENTORY"
            android:textAppearance="@style/AppTitleSmall"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPantry"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/lblListHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_pantry" />

        <TextView
            android:id="@+id/txtEmptyPantry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:text="No ingredients registered.\n\nTap the button below to populate your inventory cache with tracking parameters."
            android:textAppearance="@style/AppBodyLarge"
            android:textColor="@color/text_low_contrast"
            android:visibility="gone"
            app:drawableTopCompat="@drawable/ic_pantry_empty"
            android:drawablePadding="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Intentionally designed crisp action trigger trigger button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:layout_marginBottom="90dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Add Ingredient"
        app:backgroundTint="@color/accent_indigo"
        app:tint="@color/white"
        app:fabSize="normal"
        app:elevation="4dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:menu="@menu/bottom_nav_menu"
        style="@style/AppBottomNavStyle" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>